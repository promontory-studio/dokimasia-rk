{
  "name": "@promontory-studio/dokimasia",
  "version": "0.3.4",
  "description": "Brings no notion of a correct answer and wants none: a probe asks whether your own validator would have accepted the response, counts the attempts the shipped retry loop really spent, and reports a tie when two configurations cannot be separated.",
  "keywords": [
    "benchmark",
    "llm",
    "model-selection",
    "anthropic",
    "openai-compatible",
    "wilson-interval",
    "pre-registration"
  ],
  "license": "MIT",
  "author": "Promontory Studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/promontory-studio/dokimasia-rk.git"
  },
  "homepage": "https://github.com/promontory-studio/dokimasia-rk#readme",
  "bugs": "https://github.com/promontory-studio/dokimasia-rk/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "index.ts",
  "types": "index.ts",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "*.ts",
    "testing/**/*.ts",
    "!tests",
    "!*.test.ts"
  ],
  "exports": {
    ".": "./index.ts",
    "./client": "./client.ts",
    "./probe": "./probe.ts",
    "./buckets": "./buckets.ts",
    "./score": "./score.ts",
    "./budget": "./budget.ts",
    "./stats": "./stats.ts",
    "./rank": "./rank.ts",
    "./preregistration": "./preregistration.ts",
    "./testing/fake-openai": "./testing/fake-openai.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@types/node": "^26.6.2",
    "typescript": "~7.0.2",
    "vitest": "^5.0.1"
  }
}
